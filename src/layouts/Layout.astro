---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro"

interface Props {
	title?: string;
}

const { title } = Astro.props;
const name = "Ivan Caridad";
const pageTitle = title ? `${title} - ${name}` : `${name} - Technical Artist`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Portfolio and resume of Ivan Caridad - Technical artist working in shaders, real-time VFX, and pipeline tools."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
