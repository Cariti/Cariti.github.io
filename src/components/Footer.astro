---
const socials = [
    { href: "https://www.linkedin.com/in/ivan-caridad/", label: "LinkedIn" },
    { href: "https://github.com/Cariti", label: "GitHub" },
];
const year = new Date().getFullYear();
---

<footer>
    <div class="inner">
        <span>© {year} Ivan Caridad</span>
        <nav>
            {
                socials.map((social) => (
                    <a href={social.href} target="_blank" rel="noopener">
                        {social.label}
                    </a>
                ))
            }
        </nav>
    </div>
</footer>

<style>
    footer {
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
    }

    .inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 40px 24px;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    footer a {
        color: var(--muted);
        text-decoration: none;
    }

    footer a:hover {
        color: var(--text);
    }

    footer nav {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
</style>
