---
import Layout from "../layouts/Layout.astro";
import profile from "../assets/about/profile.jpg";
import { Image } from "astro:assets";
---

<Layout title="About">
    <main>
        <h1>About</h1>
        <section class="intro">
            <div class="intro-text">
                <p>
                    I'm a Technical Artist specialized in shader development,
                    optimization and rigging. My goal is always to bridge the
                    gap between art and tech — helping artists bring their
                    vision to life while ensuring performance, functionality and
                    efficiency.
                </p>
                <p>
                    I thrive in team environments where I can support others by
                    making their workflow smoother and more effective.
                    Colleagues often describe me as detail-oriented,
                    collaborative and committed to delivering high-quality
                    results.
                </p>
                <p>
                    Outside of work, you'll most probably find me playing Dark
                    Souls — I'm nowadays trying to complete all the
                    achievements. My next goal is no-hitting the game...
                </p>
            </div>
            <Image
                class="intro-photo"
                src={profile}
                alt="Ivan Caridad"
                width={560}
                loading="eager"
            />
        </section>

        <section class="experience">
            <h2>Experience</h2>
            <ul class="roles">
                <li>
                    <details>
                        <summary>
                            <div class="role-head">
                                <h3>
                                    Pipeline TD <span class="company">
                                        · Mago Production</span
                                    >
                                </h3>
                                <span class="dates"
                                    >Mar 2026 &ndash; Present</span
                                >
                            </div>
                            <p class="role-summary">
                                Production pipeline and internal tooling for the
                                studio's art teams.
                            </p>
                        </summary>
                        <p class="role-detail">
                            Build and maintain the pipeline that connects
                            production tracking, asset management, and DCC
                            software into one workflow — Python services,
                            artist-friendly plugins, and the server file
                            management automation behind them.
                        </p>
                        <ul class="role-bullets">
                            <li>
                                Build and maintain the production internal tools
                                for artists across the studio, focused on
                                automation and workflow efficiency.
                            </li>
                            <li>
                                Built artist-friendly tools that reduce friction
                                with the technical sides of the production.
                            </li>
                            <li>
                                Integrated Photoshop, Toon Boom Harmony and
                                Blender into a unified workflow.
                            </li>
                            <li>
                                Developed a Python pipeline service for
                                production tracking, integrated with Kitsu.
                            </li>
                        </ul>
                    </details>
                </li>

                <li>
                    <details>
                        <summary>
                            <div class="role-head">
                                <h3>
                                    Technical Art Teacher <span class="company">
                                        · Level Up [Game Dev Hub]</span
                                    >
                                </h3>
                                <span class="dates"
                                    >Nov 2025 &ndash; Jul 2026</span
                                >
                            </div>
                            <p class="role-summary">
                                Teaching technical art in Unity.
                            </p>
                        </summary>
                        <p class="role-detail">
                            Teach technical art in Unity, from shader and
                            modeling fundamentals to optimization and
                            render-pipeline customization. Build the curriculum
                            and mentor students through the full art-to-engine
                            workflow.
                        </p>
                        <ul class="role-bullets">
                            <li>
                                Teach shaders, optimization, render pipelines,
                                VFX, and lighting, with an emphasis on best
                                practices.
                            </li>
                            <li>
                                Design course material and hands-on projects
                                covering the full art-to-engine workflow.
                            </li>
                        </ul>
                    </details>
                </li>

                <li>
                    <details>
                        <summary>
                            <div class="role-head">
                                <h3>
                                    Technical Artist <span class="company">
                                        · Petoons Studio</span
                                    >
                                </h3>
                                <span class="dates">
                                    Dec 2022 &ndash; Aug 2025</span
                                >
                            </div>
                            <p class="role-summary">
                                Technical artist across multiple shipped console
                                and mobile titles with global IPs.
                            </p>
                        </summary>
                        <p class="role-detail">
                            Worked across shipped titles under tight console and
                            mobile performance budgets — shading, rendering
                            optimization, character art tech, and the art
                            workflow the teams worked with.
                        </p>
                        <ul class="role-bullets">
                            <li>
                                Developed shader sets under strict Switch and
                                mobile GPU budgets.
                            </li>
                            <li>
                                Handled rendering and memory optimization —
                                frame profiling, batching / GPU instancing,
                                impostors; ~30% draw-time reduction on one
                                title.
                            </li>
                            <li>
                                Rigged and skinned characters in Maya. Set up
                                in-engine cloth and rigid-body physics; built
                                particle VFX.
                            </li>
                            <li>
                                Defined the studio art integration workflow and
                                automated base-prefab creation to remove
                                shader/material mismatches.
                            </li>
                        </ul>
                    </details>
                </li>

                <li>
                    <details>
                        <summary>
                            <div class="role-head">
                                <h3>
                                    Character Rigger <span class="company">
                                        · Studio Kimchi</span
                                    >
                                </h3>
                                <span class="dates">
                                    Nov 2021 &ndash; Jan 2022</span
                                >
                            </div>
                            <p class="role-summary">
                                Internship &ndash; Rigging and skinning
                                characters.
                            </p>
                        </summary>
                        <p class="role-detail">
                            First studio role, an internship focused on
                            character rigging and skinning for animation
                            production.
                        </p>
                        <ul class="role-bullets">
                            <li>
                                Rigged and skinned characters in Maya for
                                animation production.
                            </li>
                            <li>
                                Followed the studio's rig conventions and
                                iterated on animator feedback.
                            </li>
                        </ul>
                    </details>
                </li>
            </ul>
        </section>

        <section class="skills">
            <h2>Skills</h2>
            <div class="skill-groups">
                <div class="skill-group">
                    <h3>Software &amp; Tools</h3>
                    <ul>
                        <li>Maya</li>
                        <li>Blender</li>
                        <li>Photoshop</li>
                        <li>Substance</li>
                        <li>RenderDoc</li>
                        <li>Git</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3>Engines</h3>
                    <ul>
                        <li>Unity</li>
                        <li>Unreal</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3>Programming</h3>
                    <ul>
                        <li>Python (PyMEL, bpy)</li>
                        <li>C#</li>
                        <li>Shader Graph</li>
                        <li>HLSL</li>
                        <li>HTML/JS/CSS</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3>Domains</h3>
                    <ul>
                        <li>Shaders</li>
                        <li>Optimization</li>
                        <li>Real-time VFX</li>
                        <li>Rigging</li>
                        <li>Pipeline &amp; Tools</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="contact">
            <h2>Contact</h2>
            <p>Let's connect! You can find me here:</p>
            <ul class="links">
                <li>
                    <button
                        type="button"
                        class="copy-btn"
                        data-copy="caridadivan.3d@gmail.com">Copy email</button
                    >
                </li>
                <li>
                    <a
                        href="https://www.linkedin.com/in/ivan-caridad/"
                        target="_blank"
                        rel="noopener">LinkedIn</a
                    >
                </li>
                <li>
                    <a
                        href="https://github.com/Cariti"
                        target="_blank"
                        rel="noopener">GitHub</a
                    >
                </li>
            </ul>
        </section>
    </main>
</Layout>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".copy-btn");

    buttons.forEach((btn) => {
        btn.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(btn.dataset.copy ?? "");

                const original = btn.textContent;
                btn.textContent = "Email copied!";
                btn.disabled = true;

                setTimeout(() => {
                    btn.textContent = original;
                    btn.disabled = false;
                }, 1500);
            } catch {
                btn.textContent = "Press Ctrl+C to copy";
            }
        });
    });
</script>

<style>
    main h2 {
        font-size: 1.5rem;
        margin: 0 0 24px;
    }

    section + section {
        margin-top: 72px;
        padding-top: 40px;
        border-top: 1px solid var(--border);
    }

    /* Introdution */
    .intro {
        display: flex;
        gap: 40px;
        align-items: flex-start;
    }

    .intro-text {
        max-width: 65ch;
    }

    .intro-photo {
        margin-left: auto;
        flex-shrink: 0;
        width: 280px;
        height: 280px;
        object-fit: cover;
        border-radius: 50%;
    }

    @media (max-width: 700px) {
        .intro {
            flex-direction: column-reverse;
            gap: 24px;
        }
    }

    .intro p {
        margin: 0 0 16px;
        color: var(--muted);
    }

    /* Experience */
    .roles {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .roles > li {
        padding: 16px 20px;
        margin-bottom: 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        transition:
            transform 0.2s,
            border-color 0.2;
    }

    .roles > li:hover {
        transform: translateY(-4px);
        border-color: var(--accent);
    }

    .roles > li:last-child {
        margin-bottom: 0;
    }

    .roles > li:has(details[open]) {
        border-color: var(--border);
        border-left: 3px solid var(--accent);
        padding-left: 18px;
    }

    .role-head {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .role-head::before {
        content: "▸";
        flex-shrink: 0;
        color: var(--accent);
        font-size: 1.5rem;
        transition: transform 0.2s;
    }

    details[open] .role-head::before {
        transform: rotate(90deg);
    }

    .role-head h3 {
        margin: 0;
        font-size: 1.05rem;
    }

    .company {
        color: var(--muted);
        font-weight: 400;
    }

    .dates {
        margin-left: auto;
        color: var(--muted);
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .roles summary {
        display: block;
        cursor: pointer;
        list-style: none;
    }

    .roles summary::-webkit-details-marker {
        display: none;
    }

    .role-summary {
        margin: 8px 0 0;
        color: var(--muted);
    }

    .role-detail {
        margin: 14px 0 0;
        color: var(--text);
    }

    .role-bullets {
        margin: 12px 0 0;
        padding-left: 32px;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.45;
    }

    .role-bullets li {
        margin: 4px 0;
    }

    /* Skills grid */

    .skill-groups {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 32px;
    }

    .skill-group h3 {
        margin: 0 0 12px;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
    }

    .skill-group ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .skill-group li {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.85rem;
    }

    /* Contact Buttons */
    .contact p {
        color: var(--muted);
        margin: 0 0 20px;
    }

    .links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .links a,
    .copy-btn {
        display: inline-block;
        padding: 10px 20px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: none;
        color: var(--text);
        font: inherit;
        text-decoration: none;
        cursor: pointer;
        transition:
            border-color 0.2s,
            color 0.2s;
    }

    .links a:hover,
    .copy-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .copy-btn:disabled {
        border-color: var(--accent);
        color: var(--accent);
        cursor: default;
    }
</style>
