---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import GameCard from "../components/GameCard.astro";
import Contact from "../components/Contact.astro";

const games = await getCollection("games");

const projects = await getCollection("projects");

const featuredGames = games
	.filter((item) => item.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredProjects = projects
	.filter((item) => item.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
	<main>
		<div class="hero">
			<p class="eyebrow">Available for work</p>
			<h1>Ivan Caridad</h1>
			<p class="role">Technical Artist</p>
			<p class="tagline">
				Building shaders, programming tools, optimization and other
				types of black magic...
			</p>
			<div class="actions">
				<a class="btn btn-primary" href="/portfolio">View work</a>
				<a class="btn" href="/about">About</a>
				<a class="btn" href="#contact">Get in touch</a>
			</div>
		</div>

		{
			featuredGames.length > 0 && (
				<section class="featured">
					<div class="featured-head">
						<h2>Featured work</h2>
						<a href="/portfolio">All games &rarr;</a>
					</div>
					<div class="grid">
						{featuredGames.map((game, index) => (
							<GameCard entry={game} eager={index < 5} />
						))}
					</div>
				</section>
			)
		}

		{
			featuredProjects.length > 0 && (
				<section class="featured">
					<div class="featured-head">
						<h2>Featured personal projects</h2>
						<a href="/portfolio">All projects &rarr;</a>
					</div>
					<div class="grid">
						{featuredProjects.map((project, index) => (
							<ProjectCard entry={project} eager={index < 5} />
						))}
					</div>
				</section>
			)
		}

		<Contact />
	</main>
</Layout>

<style>
	.hero {
		text-align: center;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: var(--accent);
		margin: 0 0 12px;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		line-height: 1.1;
		margin: 0;
	}

	.role {
		font-size: 1.5rem;
		color: var(--accent);
		margin: 8px 0 0;
	}

	.tagline {
		color: var(--muted);
		max-width: 45ch;
		margin: 24px auto 32px;
	}

	.actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		justify-content: center;
	}

	.btn {
		display: inline-block;
		padding: 12px 22px 15px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 0.15s,
			color 0.15s,
			border-color 0.15s,
			filter 0.15s;
	}

	.btn-primary {
		background-color: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	.btn:hover {
		transform: scale(1.1);
	}
	.btn:active {
		transform: scale(0.98);
	}

	/* Get in touch button */
	.btn:not(.btn-primary):hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.btn-primary:hover {
		filter: brightness(1.2);
	}

	.featured {
		margin-top: 96px;
		padding-top: 40px;
		border-top: 1px solid var(--border);
	}

	.featured-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 24px;
	}

	.featured-head h2 {
		margin: 0;
		font-size: 1.5rem;
	}

	.featured-head a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.featured-head a:hover {
		color: var(--accent);
	}
</style>
